# Copy to .env.local for local development. On Vercel, set these under
# Project -> Settings -> Environment Variables. Never commit real values.
# All of these are read on the server only (no NEXT_PUBLIC_ prefix), so they never reach the browser.

# Gemini API key (required). The secondary key is used automatically when the primary is rate-limited.
GEMINI_API_KEY=
GEMINI_API_KEY_SECONDARY=
# Optional extra backup key (also recognized)
GEMINI_API_KEY_2=

# MongoDB Atlas connection string for the LC ledger (several invoices per LC). Required on Vercel.
# Locally, when unset, the ledger is kept in data/lc-ledger.json.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="lahoti_export_docs"

# Optional: password-protect the whole app and API (HTTP Basic auth). Leave empty to turn off.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=
